<!-- SELECTION TRAY -->
<div class="tray" id="tray">
  <div class="tray-info">
    <div class="tray-count" id="trayCount">0 templates selected</div>
    <div class="tray-names" id="trayNames"></div>
  </div>
  <div style="display:flex;gap:10px;">
    <button class="tray-clear" onclick="clearAll()">Clear</button>
    <button class="tray-btn" onclick="confirmSelection()">Add to Studio →</button>
  </div>
</div>

<script>
const selected = new Set();
const names = {};

function toggleSelect(id, name) {
  const card = document.getElementById(id);
  if (selected.has(id)) {
    selected.delete(id);
    card.classList.remove('selected');
  } else {
    selected.add(id);
    names[id] = name;
    card.classList.add('selected');
  }
  updateTray();
}

function updateTray() {
  const tray = document.getElementById('tray');
  const count = document.getElementById('trayCount');
  const nameEl = document.getElementById('trayNames');
  if (selected.size > 0) {
    tray.classList.add('visible');
    count.textContent = selected.size + ' template' + (selected.size > 1 ? 's' : '') + ' selected';
    nameEl.textContent = [...selected].map(id => names[id]).join(' · ');
  } else {
    tray.classList.remove('visible');
  }
}

function clearAll() {
  selected.forEach(id => document.getElementById(id).classList.remove('selected'));
  selected.clear();
  updateTray();
}

function confirmSelection() {
  const list = [...selected].map(id => names[id]).join(', ');
  alert('Great picks! 🌸\n\nYou selected:\n' + list + '\n\nTell me these template names and I\'ll add them to the studio!');
}

function playAnim(e, previewId) {
  e.stopPropagation();
  const preview = document.getElementById(previewId);
  const card = preview.closest('.tcard');
  const overlay = card.querySelector('.play-overlay');

  // Remove go class, force reflow, add back
  preview.classList.remove('go');
  void preview.offsetWidth;
  preview.classList.add('go');
  card.classList.add('playing');
  overlay.style.opacity = '0';
  overlay.style.pointerEvents = 'none';

  setTimeout(() => {
    card.classList.remove('playing');
    overlay.style.opacity = '';
    overlay.style.pointerEvents = '';
  }, 4000);
}
</script>
</body>
</html>